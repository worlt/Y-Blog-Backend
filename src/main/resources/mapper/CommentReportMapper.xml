<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.blog.mapper.CommentReportMapper">

    <resultMap id="BaseResultMap" type="com.blog.pojo.entity.CommentReport">
        <id column="id" property="id" />
        <result column="user_id" property="userId" />
        <result column="comment_id" property="commentId" />
        <result column="report_reason" property="reportReason" />
        <result column="status" property="status" />
        <result column="report_time" property="reportTime" />
        <result column="reviewer_id" property="reviewerId" />
        <result column="review_time" property="reviewTime" />
        <result column="review_result" property="reviewResult" />
        <result column="review_reason" property="reviewReason" />
    </resultMap>
    
    <resultMap id="VOResultMap" type="com.blog.pojo.vo.CommentReportVO" extends="BaseResultMap">
        <result column="username" property="username" />
        <result column="comment_content" property="commentContent" />
        <result column="comment_user_id" property="commentUserId" />
        <result column="comment_username" property="commentUsername" />
    </resultMap>
    
    <sql id="Base_Column_List">
        id, user_id, comment_id, report_reason, status, report_time, reviewer_id, review_time, review_result, review_reason
    </sql>
    
    <insert id="add">
        insert into comment_report
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">
                user_id,
            </if>
            <if test="commentId != null">
                comment_id,
            </if>
            <if test="reportTime != null">
                report_time,
            </if>
            <if test="reportReason != null and reportReason != ''">
                report_reason,
            </if>
            <if test="status != null">
                status,
            </if>
            <if test="reviewerId != null">
                reviewer_id,
            </if>
            <if test="reviewTime != null">
                review_time,
            </if>
            <if test="reviewResult != null">
                review_result,
            </if>
            <if test="reviewReason != null and reviewReason != ''">
                review_reason
            </if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">
                #{userId},
            </if>
            <if test="commentId != null">
                #{commentId},
            </if>
            <if test="reportTime != null">
                #{reportTime},
            </if>
            <if test="reportReason != null and reportReason != ''">
                #{reportReason},
            </if>
            <if test="status != null">
                #{status},
            </if>
            <if test="reviewerId != null">
                #{reviewerId},
            </if>
            <if test="reviewTime != null">
                #{reviewTime},
            </if>
            <if test="reviewResult != null">
                #{reviewResult},
            </if>
            <if test="reviewReason != null and reviewReason != ''">
                #{reviewReason}
            </if>
        </trim>
    </insert>

    <!-- 分页查询 -->
    <select id="pageQuery" resultMap="VOResultMap">
        SELECT
            cr.id, 
            cr.user_id, 
            cr.comment_id, 
            cr.report_reason,
            cr.status, 
            cr.report_time,
            cr.review_result,
            cr.review_reason,
            u.username,
            c.content as comment_content,
            c.user_id as comment_user_id,
            u2.username as comment_username
        FROM comment_report cr
        LEFT JOIN user u ON cr.user_id = u.id
        LEFT JOIN comment c ON cr.comment_id = c.id
        LEFT JOIN user u2 ON c.user_id = u2.id
        <where>
            <if test="userId != null">AND cr.user_id = #{userId}</if>
            <if test="commentId != null">AND cr.comment_id = #{commentId}</if>
            <if test="status != null">AND cr.status = #{status}</if>
            <if test="username != null and username != ''">AND u.username LIKE CONCAT('%', #{username}, '%')</if>
            <if test="commentContent != null and commentContent != ''">AND c.content LIKE CONCAT('%', #{commentContent}, '%')</if>
        </where>
        ORDER BY cr.report_time
    </select>

    <!-- 根据id查询举报详情 -->
    <select id="getById" resultMap="VOResultMap">
        SELECT
            cr.id, 
            cr.user_id, 
            cr.comment_id, 
            cr.report_reason, 
            cr.status, 
            cr.report_time, 
            cr.reviewer_id,
            cr.review_time, 
            cr.review_result,
            cr.review_reason,
            u.username,
            c.content as comment_content,
            c.blog_id as blog_id,
            c.user_id as comment_user_id,
            u2.username as comment_username
        FROM comment_report cr
        LEFT JOIN user u ON cr.user_id = u.id
        LEFT JOIN comment c ON cr.comment_id = c.id
        LEFT JOIN user u2 ON c.user_id = u2.id
        WHERE cr.id = #{id}
    </select>

    <!-- 根据id查询举报 -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM comment_report
        WHERE id = #{id}
    </select>

    <!-- 更新举报记录 -->
    <update id="update">
        UPDATE comment_report
        <set>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="commentId != null">comment_id = #{commentId},</if>
            <if test="reportReason != null and reportReason != ''">report_reason = #{reportReason},</if>
            <if test="status != null">status = #{status},</if>
            <if test="reportTime != null">report_time = #{reportTime},</if>
            <if test="reviewerId != null">reviewer_id = #{reviewerId},</if>
            <if test="reviewTime != null">review_time = #{reviewTime},</if>
            <if test="reviewResult != null">review_result = #{reviewResult},</if>
            <if test="reviewReason != null and reviewReason != ''">review_reason = #{reviewReason},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 更新举报状态 -->
    <update id="updateStatus">
        UPDATE comment_report
        SET status = #{status}
        WHERE id = #{id}
    </update>

    <!-- 根据id删除举报 -->
    <delete id="deleteById">
        DELETE FROM comment_report
        WHERE id = #{id}
    </delete>

    <!-- 批量删除举报 -->
    <delete id="deleteByIds">
        DELETE FROM comment_report
        WHERE id IN
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper> 