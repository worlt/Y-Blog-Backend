<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.blog.mapper.CommentReportMapper">

    <resultMap id="BaseResultMap" type="com.blog.pojo.entity.CommentReport">
        <id column="id" property="id" />
        <result column="user_id" property="userId" />
        <result column="comment_id" property="commentId" />
        <result column="reason" property="reason" />
        <result column="status" property="status" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="handle_time" property="handleTime" />
        <result column="handle_result" property="handleResult" />
    </resultMap>
    
    <resultMap id="VOResultMap" type="com.blog.pojo.vo.CommentReportVO" extends="BaseResultMap">
        <result column="username" property="username" />
        <result column="comment_content" property="commentContent" />
        <result column="comment_user_id" property="commentUserId" />
        <result column="comment_username" property="commentUsername" />
    </resultMap>
    
    <sql id="Base_Column_List">
        id, user_id, comment_id, reason, status, create_time, update_time, handle_time, handle_result
    </sql>
    <insert id="add">
        insert into comment_report
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">
                user_id,
            </if>
            <if test="commentId != null">
                comment_id,
            </if>
            <if test="reportTime != null">
                report_time,
            </if>
            <if test="reportReason != null and reportReason != ''">
                report_reason,
            </if>
            <if test="status != null">
                status,
            </if>
            <if test="reviewerId != null">
                reviewer_id,
            </if>
            <if test="reviewTime != null">
                review_time,
            </if>
            <if test="reviewResult != null">
                review_result
            </if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">
                #{userId},
            </if>
            <if test="commentId != null">
                #{commentId},
            </if>
            <if test="reportTime != null">
                #{reportTime},
            </if>
            <if test="reportReason != null and reportReason != ''">
                #{reportReason},
            </if>
            <if test="status != null">
                #{status},
            </if>
            <if test="reviewerId != null">
                #{reviewerId},
            </if>
            <if test="reviewTime != null">
                #{reviewTime}
            </if>
            <if test="reviewResult != null">
                #{reviewResult}
            </if>
        </trim>
    </insert>

    <!-- 分页查询 -->
    <select id="pageQuery" resultMap="VOResultMap">
        SELECT
            cr.id, 
            cr.user_id, 
            cr.comment_id, 
            cr.reason, 
            cr.status, 
            cr.create_time, 
            cr.update_time, 
            cr.handle_time, 
            cr.handle_result,
            u.username,
            c.content as comment_content,
            c.user_id as comment_user_id,
            u2.username as comment_username
        FROM comment_report cr
        LEFT JOIN user u ON cr.user_id = u.id
        LEFT JOIN comment c ON cr.comment_id = c.id
        LEFT JOIN user u2 ON c.user_id = u2.id
        <where>
            <if test="userId != null">AND cr.user_id = #{userId}</if>
            <if test="commentId != null">AND cr.comment_id = #{commentId}</if>
            <if test="status != null">AND cr.status = #{status}</if>
        </where>
        ORDER BY cr.create_time DESC
    </select>

    <!-- 根据id查询举报详情 -->
    <select id="getById" resultMap="VOResultMap">
        SELECT
            cr.id, 
            cr.user_id, 
            cr.comment_id, 
            cr.reason, 
            cr.status, 
            cr.create_time, 
            cr.update_time, 
            cr.handle_time, 
            cr.handle_result,
            u.username,
            c.content as comment_content,
            c.user_id as comment_user_id,
            u2.username as comment_username
        FROM comment_report cr
        LEFT JOIN user u ON cr.user_id = u.id
        LEFT JOIN comment c ON cr.comment_id = c.id
        LEFT JOIN user u2 ON c.user_id = u2.id
        WHERE cr.id = #{id}
    </select>

    <!-- 根据id查询举报 -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM comment_report
        WHERE id = #{id}
    </select>

    <!-- 更新举报记录 -->
    <update id="update">
        UPDATE comment_report
        <set>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="commentId != null">comment_id = #{commentId},</if>
            <if test="reason != null">reason = #{reason},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="handleTime != null">handle_time = #{handleTime},</if>
            <if test="handleResult != null">handle_result = #{handleResult},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 根据id删除举报 -->
    <delete id="deleteById">
        DELETE FROM comment_report
        WHERE id = #{id}
    </delete>

    <!-- 批量删除举报 -->
    <delete id="deleteByIds">
        DELETE FROM comment_report
        WHERE id IN
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper> 