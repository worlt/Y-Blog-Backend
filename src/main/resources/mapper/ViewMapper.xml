<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.blog.mapper.ViewMapper">

    <resultMap id="BaseResultMap" type="com.blog.pojo.entity.View">
        <id column="id" property="id" />
        <result column="user_id" property="userId" />
        <result column="blog_id" property="blogId" />
        <result column="view_time" property="viewTime" />
        <result column="ip" property="ip" />
    </resultMap>
    
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO view
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="blogId != null">blog_id,</if>
            <if test="viewTime != null">view_time,</if>
            <if test="ip != null">ip,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="blogId != null">#{blogId},</if>
            <if test="viewTime != null">#{viewTime},</if>
            <if test="ip != null">#{ip},</if>
        </trim>
    </insert>

    <select id="findByIpAndBlogId" resultMap="BaseResultMap">
        SELECT * FROM view WHERE ip = #{ip} AND blog_id = #{blogId}
    </select>
    
    <select id="getUserViewHistoryPage" resultType="com.blog.pojo.vo.BlogVO">
        SELECT
            b.id,
            b.title,
            b.content,
            b.cover,
            b.views,
            b.likes,
            b.dislikes,
            b.collections,
            b.publish_time,
            b.create_time,
            u.id AS userId,
            u.username,
            u.avatar,
            c.name AS categoryName,
            v.view_time AS viewTime
        FROM
            view v
            JOIN blog b ON v.blog_id = b.id
            JOIN user u ON b.user_id = u.id
            LEFT JOIN category c ON b.category_id = c.id
        WHERE
            v.user_id = #{userId}
        <if test="title != null and title != ''">
            AND (b.title LIKE CONCAT('%', #{title}, '%') OR b.content LIKE CONCAT('%', #{title}, '%'))
        </if>
        <if test="categoryId != null">
            AND b.category_id = #{categoryId}
        </if>
        ORDER BY v.view_time DESC
    </select>
</mapper> 