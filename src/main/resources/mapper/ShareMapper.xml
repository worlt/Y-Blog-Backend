<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.blog.mapper.ShareMapper">

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO share
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="blogId != null">blog_id,</if>
            <if test="shareTime != null">share_time,</if>
            <if test="sharePlatform != null">share_platform,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="blogId != null">#{blogId},</if>
            <if test="shareTime != null">#{shareTime},</if>
            <if test="sharePlatform != null">#{sharePlatform},</if>
        </trim>
    </insert>
</mapper> 