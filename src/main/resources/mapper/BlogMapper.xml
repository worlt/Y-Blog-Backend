<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.blog.mapper.BlogMapper">
    <insert id="add" useGeneratedKeys="true" keyProperty="id">
        insert into blog(title, content, publish_time, update_time, views, likes, dislikes, collections, shares,
                         user_id, category_id, status)
        values (#{title}, #{content}, #{publishTime}, #{updateTime}, #{views}, #{likes}, #{dislikes}, #{collections},
                #{shares}, #{userId},
                #{categoryId}, #{status})
    </insert>


    <select id="page" resultType="com.blog.pojo.vo.BlogVO">
        select b.id,
               b.title,
               b.content,
               b.publish_time,
               b.update_time,
               b.views,
               b.likes,
               b.dislikes,
               b.collections,
               b.shares,
               b.user_id,
               u.username,
               u.avatar,
               b.category_id,
               c.name as category,
               b.status
        from blog b
                 left join user u on b.user_id = u.id
                 left join category c on b.category_id = c.id
    </select>


