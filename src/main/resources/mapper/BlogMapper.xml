<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.blog.mapper.BlogMapper">
    <insert id="add" useGeneratedKeys="true" keyProperty="id">
        insert into blog(title, content, create_time, publish_time, update_time, views, likes, dislikes, collections, shares,
                         user_id, category_id, status)
        value (#{title}, #{content}, #{createTime}, #{publishTime}, #{updateTime}, #{views},
               #{likes}, #{dislikes}, #{collections}, #{shares}, #{userId}, #{categoryId}, #{status})
    </insert>
    <update id="update">
        update blog
        <set>
            <if test="title != null and title != ''">
                title = #{title},
            </if>
            <if test="content != null and content != ''">
                content = #{content},
            </if>
            <if test="createTime != null">
                create_time = #{createTime}，
            </if>
            <if test="publishTime != null">
                publish_time = #{publishTime},
            </if>
            <if test="updateTime != null">
                update_time = #{updateTime},
            </if>
            <if test="views != null">
                views = #{views},
            </if>
            <if test="likes != null">
                likes = #{likes},
            </if>
            <if test="dislikes != null">
                dislikes = #{dislikes},
            </if>
            <if test="collections != null">
                collections = #{collections},
            </if>
            <if test="shares != null">
                shares = #{shares},
            </if>
            <if test="userId != null">
                user_id = #{userId},
            </if>
            <if test="categoryId != null">
                category_id = #{categoryId},
            </if>
            <if test="status != null">
                status = #{status}
            </if>
        </set>
        where id = #{id}
    </update>


    <select id="page" resultType="com.blog.pojo.vo.BlogVO">
        select b.id,
               b.title,
               b.content,
               b.create_time,
               b.publish_time,
               b.update_time,
               b.views,
               b.likes,
               b.dislikes,
               b.collections,
               b.shares,
               b.user_id,
               u.username,
               u.avatar,
               b.category_id,
               c.name as category,
               b.status
        from blog b
                 left join user u on b.user_id = u.id
                 left join category c on b.category_id = c.id
        <where>
            <if test="title != null and title != ''">
                b.title like concat('%', #{title}, '%')
            </if>
        </where>
        order by b.publish_time desc
    </select>


